# ─── Server ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017/donation_platform
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/donation_platform?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────
# Frontend origin (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# ─── Email Configuration (Nodemailer) ──────────────────────────────────
# Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_16_chars

# ─── Contact Form Recipient ──────────────────────────────────────────────
# Email address that receives messages submitted via the contact form
ADMIN_EMAIL=your_admin_email@gmail.com
